# Adresse publique du site, sans barre finale : URL canonique, aperçus LinkedIn / WhatsApp, sitemap.
# Sur Vercel, elle est déduite automatiquement si vous la laissez vide.
VITE_SITE_URL=

# Facultatif : URL qui reçoit le formulaire de contact en POST JSON (Formspree, votre API Laravel…).
# Laissez vide pour que le formulaire ouvre la messagerie du visiteur.
# Jamais de clé secrète ici : les variables VITE_ sont visibles dans le navigateur.
VITE_CONTACT_ENDPOINT=

# Facultatif : true pour activer Vercel Web Analytics (à activer aussi dans le tableau de bord Vercel).
VITE_ENABLE_ANALYTICS=
