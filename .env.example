# Adresse publique du site, sans barre finale (utilisée pour Open Graph et l'URL canonique)
VITE_SITE_URL=https://votre-domaine.vercel.app

# Optionnel : URL qui reçoit le formulaire de contact en POST JSON (Formspree, votre API Laravel…)
# Laissez vide pour que le formulaire ouvre la messagerie du visiteur.
# Jamais de clé secrète ici : les variables VITE_ sont visibles dans le navigateur.
VITE_CONTACT_ENDPOINT=
